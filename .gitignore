# Dependencies
node_modules/

# Build output and caches
dist/
.turbo/
coverage/
*.tsbuildinfo

# Playwright (pnpm e2e)
test-results/
playwright-report/
blob-report/

# AWS Architecture Icons: downloaded by pnpm icons:fetch, never committed (ADR-0012)
apps/web/public/icons/
.cache/

# Temporary files of the atomic writes of the Studio server (ADR-0025, S7)
*.studio-tmp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
# The fake login of the e2e build (ADR-0029): no secrets.
!apps/web/.env.e2e

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
.terraform.tfstate.lock.info
.terraform-plugins/
crash.log

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
