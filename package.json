{
  "name": "blueprint",
  "version": "0.0.0",
  "private": true,
  "description": "Juego web para aprender a diseñar arquitecturas en AWS completando diagramas.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@blueprint/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
