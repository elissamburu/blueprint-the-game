# Build of the e2e tests only (`vite build --mode e2e`, from `pnpm e2e`): the fake login and
# profile of src/auth/fake-session.ts, with no AWS (ADR-0029). vite.config.ts fails any other build
# with this variable, and pnpm deploy:site refuses a site that contains the fake.
VITE_AUTH_FAKE=true
# The button "Continuar con Google" too: the fake signs in the same way, without Google.
VITE_AUTH_GOOGLE=true
