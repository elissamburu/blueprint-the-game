{
  "name": "@blueprint/studio",
  "version": "0.0.0",
  "private": true,
  "description": "Scenario Studio: editor local de escenarios (UI React + servidor Hono en 127.0.0.1). Nunca se despliega.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "tsx server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "clean": "rimraf dist coverage .turbo test-results playwright-report"
