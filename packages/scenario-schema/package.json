{
  "name": "@blueprint/scenario-schema",
  "version": "0.0.0",
  "private": true,
  "description": "Schema Zod de escenarios, catálogo, insignias y game-rules (puro, sin IO).",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "exports": {
    ".": {
